# Cấu hình riêng, khóa và thông tin xác thực không được đưa lên GitHub.
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
*.pem
*.key
credentials*
# Dữ liệu phát sinh khi vận hành hoặc kiểm thử, không phải mã nguồn.
checkpoints/
data/
runtime/
logs/
*.log
# Cache, file biên dịch và file tạm của trình soạn thảo.
__pycache__/
*.py[cod]
.pytest_cache/
.cache/
tmp/
tests/tmp/
*.tmp
*.swp
.DS_Store

work/
tests/evidence/
multihost/evidence*/

# Giữ hai bootstrap trong config/assets/ và multihost/assets/ để clone xong có thể dùng.
