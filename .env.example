# Edit RUN_ID and EXCLUSIVE_OWNER_ACK before config/start. No static secret is required.
# RUN_ID format: YYYYMMDDtHHMMSSz-xxxxxxxx (UTC and 8 random lowercase hex characters).
# EXCLUSIVE_OWNER_ACK=true confirms no other controller/manual round writer.
IMAGE_NAMESPACE=24520115
SN_VERSION=v0.1.0-arm64
SL_VERSION=v0.1.0-arm64
USER_TF_VERSION=v0.1.0-arm64
SWOP_VERSION=v0.1.0-arm64
RUN_ID=
EXCLUSIVE_OWNER_ACK=
SN_PORT=8000
SL_PORT=9000
CONTROLLER_PORT=9200
ROUNDS=2
SAMPLES_A=16
SAMPLES_B=32
DATA_SEED_A=100
DATA_SEED_B=200
EPOCHS=2
BATCH_SIZE=16
LEARNING_RATE=0.05
STARTUP_TIMEOUT=600
ROUND_TIMEOUT=600
