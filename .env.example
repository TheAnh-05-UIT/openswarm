# Điền RUN_ID mới trước khi chạy; không cần static secret.
# RUN_ID: YYYYMMDDtHHMMSSz-xxxxxxxx, gồm thời gian UTC và 8 ký tự hex ngẫu nhiên.
# Chỉ đặt true khi job có đúng một controller, không có người mở round khác.
IMAGE_NAMESPACE=24520115
SN_VERSION=v0.1.0-arm64
SL_VERSION=v0.1.0-arm64
USER_TF_VERSION=v0.1.0-arm64
SWOP_VERSION=v0.1.0-arm64
RUN_ID=
EXCLUSIVE_OWNER_ACK=
SN_PORT=8000
SL_PORT=9000
CONTROLLER_PORT=9200
ROUNDS=2
SAMPLES_A=16
SAMPLES_B=32
DATA_SEED_A=100
DATA_SEED_B=200
EPOCHS=2
BATCH_SIZE=16
LEARNING_RATE=0.05
STARTUP_TIMEOUT=600
ROUND_TIMEOUT=600
